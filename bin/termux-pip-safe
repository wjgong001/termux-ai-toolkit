#!/data/data/com.termux/files/usr/bin/bash
#
# termux-pip-safe — 在 Termux 上安全安装 Python 包
#
# 解决：pip install 在 Termux 上经常编译失败，找不到预编译 wheel
# 本脚本自动尝试：直接装 → 换源 → 降版本 → 拆依赖安装
#
# 用法:
#   termux-pip-safe numpy
#   termux-pip-safe pandas==2.0.0
#   termux-pip-safe -r requirements.txt

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()  { echo -e "${GREEN}[✓]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[✗]${NC} $1"; }
info() { echo -e "${CYAN}[i]${NC} $1"; }

# 检测 Termux 环境
detect_termux() {
  if [[ -d /data/data/com.termux && "$PREFIX" == *"com.termux"* ]]; then
    return 0
  fi
  return 1
}

# 尝试安装，失败返回非0
try_install() {
  local pkg="$1"
  local extra_args="$2"
  info "pip install $pkg $extra_args"
  if pip install "$pkg" $extra_args 2>/dev/null; then
    return 0
  fi
  return 1
}

# 获取包名（去掉版本号）
get_base_pkg() {
  local pkg="$1"
  # pandas==2.0.0 -> pandas
  echo "$pkg" | sed -E 's/==.*$//; s/~=.*$//; s/>=.*$//; s/<=.*$//; s/[><=].*$//'
}

# 获取完整包名+版本
get_pkg_version() {
  local pkg="$1"
  echo "$pkg"
}

install_pkg() {
  local pkg="$1"
  local base
  base=$(get_base_pkg "$pkg")
  
  # 检查系统包中是否有对应python-*包
  if detect_termux; then
    local termux_pkg="python-${base}"
    if pkg list-installed 2>/dev/null | grep -qi "^${termux_pkg}/"; then
      warn "$base 已通过 termux 系统包安装"
      return 0
    fi
  fi
  
  # 策略1: 直接安装
  info "策略1: 直接安装 $pkg"
  if try_install "$pkg" ""; then
    log "$pkg 安装成功"
    return 0
  fi
  
  # 策略2: 换国内源
  warn "策略2: 换国内源重试 $pkg"
  local mirrors=(
    "https://pypi.tuna.tsinghua.edu.cn/simple"
    "https://mirrors.aliyun.com/pypi/simple/"
    "https://pypi.mirrors.ustc.edu.cn/simple/"
  )
  for mirror in "${mirrors[@]}"; do
    if try_install "$pkg" "-i $mirror"; then
      log "$pkg 通过 $mirror 安装成功"
      return 0
    fi
  done
  
  # 策略3: 降级安装（去掉版本限制）
  if echo "$pkg" | grep -qE "==|>=|<="; then
    local base_only
    base_only=$(get_base_pkg "$pkg")
    warn "策略3: 降级到 $base_only (无版本限制)"
    if try_install "$base_only" ""; then
      log "$base_only (降级) 安装成功"
      return 0
    fi
    # 降级+换源
    for mirror in "${mirrors[@]}"; do
      if try_install "$base_only" "-i $mirror"; then
        log "$base_only 通过 $mirror 降级安装成功"
        return 0
      fi
    done
  fi
  
  # 策略4: 尝试不带依赖安装，然后逐个装依赖
  warn "策略4: 拆依赖安装 $base"
  if pip install "$base" --no-deps 2>/dev/null; then
    log "$base (无依赖) 安装成功，尝试安装轻量替代..."
    # 常见包的轻量替代
    case "$base" in
      pandas)
        info "尝试安装 pandas 的轻量替代..."
        pip install polars 2>/dev/null && log "已安装 polars 替代 pandas" && return 0
        ;;
      scipy)
        info "scipy 编译困难，建议: pkg install python-scipy"
        warn "尝试 pip install 旧版 scipy..."
        pip install scipy==1.9.0 2>/dev/null && log "scipy 1.9.0 安装成功" && return 0
        ;;
      numpy)
        info "尝试 numpy 旧版..."
        pip install numpy==1.24.0 2>/dev/null && log "numpy 1.24.0 安装成功" && return 0
        ;;
      Pillow)
        info "Pillow 在 Termux 上建议用: pkg install python-pillow"
        pip install Pillow==9.5.0 2>/dev/null && log "Pillow 9.5.0 安装成功" && return 0
        ;;
    esac
    return 1
  fi
  
  return 1
}

# 主流程
main() {
  if ! detect_termux; then
    warn "未检测到 Termux 环境，直接使用 pip"
    pip install "$@"
    exit $?
  fi
  
  local pkgs=()
  local req_file=""
  
  # 解析参数
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--requirement)
        req_file="$2"
        shift 2
        ;;
      -*)
        # 忽略其他 pip 参数
        shift
        ;;
      *)
        pkgs+=("$1")
        shift
        ;;
    esac
  done
  
  local success=0
  local failed=0
  
  if [[ -n "$req_file" ]]; then
    info "从 $req_file 读取依赖..."
    while IFS= read -r line; do
      line=$(echo "$line" | sed 's/#.*//' | xargs)
      [[ -z "$line" ]] && continue
      if install_pkg "$line"; then
        ((success++))
      else
        ((failed++))
        err "安装失败: $line"
      fi
    done < "$req_file"
  fi
  
  for pkg in "${pkgs[@]}"; do
    if install_pkg "$pkg"; then
      ((success++))
    else
      ((failed++))
      err "安装失败: $pkg"
    fi
  done
  
  echo ""
  if [[ $failed -eq 0 ]]; then
    log "全部安装成功 ($success 个)"
  else
    warn "成功 $success, 失败 $failed 个"
    echo -e "${YELLOW}建议:${NC}"
    echo "  1. 试试 pkg install python-包名 (如 pkg install python-numpy)"
    echo "  2. 在 Hermes 中搜 termux-python-deps skill 查看已知兼容版本"
    echo "  3. 用 \`pip download 包名\` 查看具体编译错误"
  fi
}

main "$@"
